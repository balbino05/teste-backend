											"    pm.expect(jsonData).to.have.property('message');",
											"    ",
											"    // Salva o transaction_id para referência",
											"    if (jsonData.transaction_id) {",
											"        pm.environment.set('last_transaction_id', jsonData.transaction_id.toString());",
